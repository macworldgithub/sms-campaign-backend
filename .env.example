PORT=4000
# Set to your connector .env path; secrets are loaded without copying them.
SHARED_ENV_FILE=../metaphor-replacement-api/.env
PORTAL_API_KEY=
LEAD_WEBHOOK_KEY=
MOBILEMESSAGE_WEBHOOK_SECRET=
MONGODB_URI=
MONGODB_DB_NAME=sms_campaign
# Used only by the one-time migration CLI, never by the running server.
SQLITE_MIGRATION_SOURCE=data/campaign.sqlite
DEALERSOCKET_CONNECTOR_URL=http://127.0.0.1:8000
DEALERSOCKET_WORKER_MODE=chrome
DEALERSOCKET_CAMPAIGN_WRITES_ENABLED=false
CAMPAIGN_SEND_ENABLED=false
SMS_TEST_SEND_ENABLED=false
SMS_INBOX_POLL_ENABLED=false
DEALERSOCKET_SMS_ACTIVITY_ENABLED=false
MOBILEMESSAGE_TEST_RECIPIENT=
SMS_SENDER_REGISTERED=false
SMS_MAX_PER_WINDOW=1
SMS_FREQUENCY_WINDOW_HOURS=720
PUBLIC_PORTAL_URL=
LOYALTY_EMBED_URL=https://smh-loyalty-embed.netlify.app
